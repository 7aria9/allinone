<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AllInOne.Core\AllInOne.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nom distinct de AllInOne.exe : Windows ne distingue pas les majuscules, les deux exe s'écraseraient. -->
    <AssemblyName>allinone-cli</AssemblyName>
    <RootNamespace>AllInOne.Cli</RootNamespace>
  </PropertyGroup>

</Project>
