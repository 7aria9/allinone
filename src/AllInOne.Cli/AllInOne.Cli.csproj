<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AllInOne.Core\AllInOne.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nom distinct de LocalConvert.exe : Windows ne distingue pas les majuscules, les deux exe s'écraseraient. -->
    <AssemblyName>localconvert-cli</AssemblyName>
    <RootNamespace>AllInOne.Cli</RootNamespace>
    <!-- Même icône que l'application dans l'Explorateur Windows. -->
    <ApplicationIcon>..\..\assets\icon\localconvert.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
