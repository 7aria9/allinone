<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AllInOne.App.Views"
        x:Class="AllInOne.App.MainWindow"
        Title="LocalConvert : PDF, images, vidéos et sons" Width="1180" Height="780" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="avares://LocalConvert/Assets/localconvert.ico">
    <DockPanel>
        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradient}" Padding="24,16,24,14">
            <DockPanel>
                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="130"
                          ToolTip.Tip="Langue de l'application" />
                <Image DockPanel.Dock="Left" Source="avares://LocalConvert/Assets/localconvert-128.png" Width="56" Height="56"
                       Margin="-6,0,8,0" VerticalAlignment="Center" />
                <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LOCAL" FontSize="28" FontWeight="Black" />
                    <TextBlock Text="CONVERT" FontSize="28" FontWeight="Black" Foreground="{StaticResource AccentGradient}" />
                    <TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Bottom" Margin="10,0,0,5" />
                </StackPanel>
                <TextBlock Text="Tes PDF, images, vidéos et sons, sans rien envoyer sur Internet" Foreground="{StaticResource TextDim}" FontSize="13" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Arrêter" Click="Cancel_Click"
                        IsVisible="False" Padding="10,3" Margin="10,0,0,0" />
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Classes="thin" Width="200"
                             VerticalAlignment="Center" IsVisible="False" />
                <TextBlock x:Name="StatusText" Text="Prêt." Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border x:Name="Nav" DockPanel.Dock="Left" Width="240" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,18">
            <StackPanel>
                <TextBlock Text="OUTILS" Classes="section" Margin="14,0,0,10" />
                <RadioButton Classes="nav" GroupName="nav" Content="🖼   Images → PDF" Tag="0" IsChecked="True" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="📄   Modifier / fusionner" Tag="1" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="🗜   Compresser un PDF" Tag="2" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="✂   Découper un PDF" Tag="3" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="🧩   PDF → images" Tag="4" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="🔁   Convertir des images" Tag="5" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="🎬   Vidéos et GIF" Tag="6" IsCheckedChanged="Nav_Checked" />
                <RadioButton Classes="nav" GroupName="nav" Content="🎵   Convertir des sons" Tag="7" IsCheckedChanged="Nav_Checked" />
            </StackPanel>
        </Border>

        <!-- Contenu : un seul écran visible à la fois (les autres gardent leur état) -->
        <Panel x:Name="Pages" Margin="24,20,24,16">
            <views:ImagesToPdfView />
            <views:PdfEditorView IsVisible="False" />
            <views:CompressPdfView IsVisible="False" />
            <views:SplitPdfView IsVisible="False" />
            <views:PdfToImagesView IsVisible="False" />
            <views:ConvertImagesView IsVisible="False" />
            <views:ConvertVideosView IsVisible="False" />
            <views:ConvertAudioView IsVisible="False" />
        </Panel>
    </DockPanel>
</Window>
