<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème sombre repris de Scan-Online : fond nuit, accents rose néon → violet. -->
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#FF3D7F</Color>
            <Color x:Key="Accent2Color">#8B5CF6</Color>
            <!-- Couleur d'accent de Fluent (focus, sélection, cases cochées). -->
            <Color x:Key="SystemAccentColor">#FF3D7F</Color>
            <Color x:Key="SystemAccentColorDark1">#E0336F</Color>
            <Color x:Key="SystemAccentColorLight1">#FF5C93</Color>

            <SolidColorBrush x:Key="Bg" Color="#0E0E13" />
            <SolidColorBrush x:Key="Surface" Color="#17171F" />
            <SolidColorBrush x:Key="Surface2" Color="#22222D" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#2A2A37" />
            <SolidColorBrush x:Key="Line" Color="#2E2E3B" />
            <SolidColorBrush x:Key="Text" Color="#F1F1F6" />
            <SolidColorBrush x:Key="TextDim" Color="#9C9CB2" />
            <SolidColorBrush x:Key="Accent" Color="#FF3D7F" />
            <SolidColorBrush x:Key="Accent2" Color="#8B5CF6" />
            <SolidColorBrush x:Key="Success" Color="#4ADE80" />
            <SolidColorBrush x:Key="Danger" Color="#F87171" />
            <SolidColorBrush x:Key="Warning" Color="#FBBF24" />

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FF3D7F" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#3A1230" Offset="0" />
                <GradientStop Color="#1E1440" Offset="0.55" />
                <GradientStop Color="#0E0E13" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NavSelected" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#4A1838" Offset="0" />
                <GradientStop Color="#2A1B4D" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CoverPlaceholder" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#2B1B3D" Offset="0" />
                <GradientStop Color="#151522" Offset="1" />
            </LinearGradientBrush>

            <!-- Champs de saisie et listes déroulantes de Fluent aux couleurs du thème. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#22222D" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A37" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1B1B24" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E2E3B" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF3D7F" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#22222D" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2A2A37" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E2E3B" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF3D7F" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1B1B24" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2E2E3B" />
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Boutons -->
    <Style Selector="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1B1B24" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="#5C5C70" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style Selector="Button.big">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Textes -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.dropHint">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Label">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Padding" Value="0,0,10,0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cartes -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Listes de fichiers : chaque élément est une carte arrondie -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#241B33" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentGradient}" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2C2140" />
    </Style>

    <!-- Navigation latérale -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bd" Background="Transparent" CornerRadius="10" Padding="14,11" Margin="0,2">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bd">
        <Setter Property="Background" Value="{StaticResource NavSelected}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Barre de progression fine -->
    <Style Selector="ProgressBar.thin">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- État d'une ligne de conversion -->
    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.status.running">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="TextBlock.status.done">
        <Setter Property="Foreground" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="TextBlock.status.failed">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
</Styles>
