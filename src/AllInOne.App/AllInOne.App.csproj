<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllInOne</AssemblyName>
    <RootNamespace>AllInOne.App</RootNamespace>
    <!-- Permet de compiler (sans exécuter) l'application WPF depuis Linux/macOS, par exemple en CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!--
      Compilation pour Windows 64 bits, dépendante du runtime .NET installé : le dossier de sortie contient
      AllInOne.exe et ses DLL côte à côte, uniquement les bibliothèques natives x64 (pas celles des autres plateformes).
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllInOne.Core\AllInOne.Core.csproj" />
  </ItemGroup>

</Project>
