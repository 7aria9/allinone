<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalConvert</AssemblyName>
    <RootNamespace>AllInOne.App</RootNamespace>
    <!-- Liaisons par réflexion dans les modèles XAML (plus simple que les liaisons compilées pour ces petites listes). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Avalonia annote plus de propriétés comme « nullables » que WPF (Text, Tag…) : avertissements sans conséquence ici. -->
    <NoWarn>$(NoWarn);CA1416;CS8600;CS8602;CS8604</NoWarn>
    <!-- Les DLL restent à côté de l'exécutable (pas d'exe unique de 200 Mo). -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia (licence MIT) : interface identique sous Windows, macOS et Linux.
      SkiaSharp est partagé avec PDFtoImage : les deux doivent rester sur la même version majeure (3.x).
    -->
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- Avalonia tire encore les bibliothèques natives Linux 2.88 : on impose celles de SkiaSharp 3. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllInOne.Core\AllInOne.Core.csproj" />
  </ItemGroup>

</Project>
