<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllInOne</AssemblyName>
    <RootNamespace>AllInOne.App</RootNamespace>
    <!-- Permet de compiler (sans exécuter) l'application WPF depuis Linux/macOS, par exemple en CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Les bibliothèques natives (PDFium, SkiaSharp, ImageMagick) sont fournies pour Windows x64/x86/arm64. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AllInOne.Core\AllInOne.Core.csproj" />
  </ItemGroup>

</Project>
