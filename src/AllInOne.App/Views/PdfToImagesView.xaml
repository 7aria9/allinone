<UserControl x:Class="AllInOne.App.Views.PdfToImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="PDF → images" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                   Text="Chaque page du PDF devient une image. Tu peux glisser un PDF n'importe où sur cet écran." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FICHIER" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowsePdf_Click" Margin="8,0,0,0" />
                        <TextBox x:Name="PdfPath" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock x:Name="PageCount" Foreground="{StaticResource TextDim}" FontSize="12" Margin="2,0,0,16" />

                    <TextBlock Text="OPTIONS" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="Pages" />
                        <TextBox Grid.Column="1" x:Name="PageText" Margin="0,0,0,8"
                                 ToolTip="Exemples : 1-3,5 ou 4- (vide = toutes les pages)" />
                        <Label Grid.Row="1" Content="Format" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Format" SelectionChanged="Format_SelectionChanged" Margin="0,0,0,8" />
                        <Label Grid.Row="2" Content="Résolution" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Dpi" SelectedIndex="2" Margin="0,0,0,8">
                            <ComboBoxItem Content="72 DPI (écran)" Tag="72" />
                            <ComboBoxItem Content="96 DPI" Tag="96" />
                            <ComboBoxItem Content="150 DPI (conseillé)" Tag="150" />
                            <ComboBoxItem Content="200 DPI" Tag="200" />
                            <ComboBoxItem Content="300 DPI (impression)" Tag="300" />
                            <ComboBoxItem Content="600 DPI" Tag="600" />
                        </ComboBox>
                        <Label Grid.Row="3" x:Name="QualityLabel" Content="Qualité" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Quality}" Width="30"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="Quality" Minimum="10" Maximum="100" Value="90" VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True" TickFrequency="5" />
                        </DockPanel>
                    </Grid>

                    <TextBlock Text="DESTINATION" Style="{StaticResource SectionTitle}" Margin="0,12,0,10" />
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                        <TextBox x:Name="OutputDir" />
                    </DockPanel>

                    <Button Content="🧩  Convertir en images" Style="{StaticResource PrimaryButton}" Click="Convert_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="14" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Style="{StaticResource DropHint}" Text="Dépose un PDF ici&#x0a;pour voir sa première page" />
                <Image x:Name="Preview" Stretch="Uniform" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
