<UserControl x:Class="AllInOne.App.Views.PdfToImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Hint}"
                   Text="Convertit les pages d'un PDF en images (une image par page). Vous pouvez glisser un PDF ici." />

        <Label Grid.Row="1" Content="Fichier PDF :" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PdfPath" IsReadOnly="True" />
        <Button Grid.Row="1" Grid.Column="2" Content="Parcourir…" Click="BrowsePdf_Click" />

        <Label Grid.Row="2" Content="Dossier de sortie :" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="OutputDir" />
        <Button Grid.Row="2" Grid.Column="2" Content="Parcourir…" Click="BrowseOutput_Click" />

        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <Label Content="Pages :" />
            <TextBox x:Name="PageText" Width="140" ToolTip="Exemples : 1-3,5 ou 4- (vide = toutes les pages)" />
            <TextBlock x:Name="PageCount" VerticalAlignment="Center" Foreground="#666" Margin="0,0,16,6" />
            <Label Content="Format :" />
            <ComboBox x:Name="Format" SelectionChanged="Format_SelectionChanged" />
            <Label Content="Résolution (DPI) :" />
            <ComboBox x:Name="Dpi" IsEditable="True" Text="150" MinWidth="80">
                <ComboBoxItem Content="72" />
                <ComboBoxItem Content="96" />
                <ComboBoxItem Content="150" />
                <ComboBoxItem Content="200" />
                <ComboBoxItem Content="300" />
                <ComboBoxItem Content="600" />
            </ComboBox>
            <Label x:Name="QualityLabel" Content="Qualité :" />
            <Slider x:Name="Quality" Minimum="10" Maximum="100" Value="90" Width="120" VerticalAlignment="Center"
                    IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,0,4,6" />
            <TextBlock Text="{Binding Value, ElementName=Quality}" VerticalAlignment="Center" Width="30" Margin="0,0,12,6" />
        </WrapPanel>

        <WrapPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <Button Content="Convertir en images" Style="{StaticResource PrimaryButton}" Click="Convert_Click" />
        </WrapPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,0" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA">
            <Image x:Name="Preview" Stretch="Uniform" Margin="6" />
        </Border>
    </Grid>
</UserControl>
