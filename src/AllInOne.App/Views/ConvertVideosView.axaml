<UserControl x:Class="AllInOne.App.Views.ConvertVideosView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Convertir des vidéos" Classes="pageTitle" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="hint"
                   Text="Convertis tes vidéos en MP4, MKV, WebM, AVI, OGG, MOV ou GIF animé, en entier ou seulement un extrait, ou extrais-en les images en PNG ou JPEG. Les originaux ne sont jamais modifiés. La conversion utilise FFmpeg, téléchargé automatiquement la première fois." />

        <Border Grid.Row="2" Classes="card" Margin="0,0,16,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="＋  Ajouter des vidéos" Classes="primary" Click="Add_Click" />
                    <Button Content="🗑  Retirer" Click="Remove_Click" />
                    <Button Content="Vider" Classes="ghost" Click="Clear_Click" />
                </WrapPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <DockPanel>
                        <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="⬇  Télécharger FFmpeg" Click="Download_Click"
                                IsVisible="False" />
                        <TextBlock x:Name="FfmpegStatus" Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Classes="dropHint"
                               Text="Dépose tes vidéos ici&#x0a;MP4, MKV, WebM, AVI, OGG, MOV, WMV, FLV, MPEG, TS, 3GP…" />
                    <ListBox x:Name="Files" Classes="cards" SelectionMode="Multiple"
                             ItemTemplate="{StaticResource MediaItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Classes="card">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SORTIE" Classes="section" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Format" />
                    <ComboBox Grid.Column="1" x:Name="Format" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="Format_SelectionChanged">
                        <ComboBoxItem Content="MP4 (H.264 + AAC)" Tag="Mp4" />
                        <ComboBoxItem Content="MKV (H.264 + AAC)" Tag="Mkv" />
                        <ComboBoxItem Content="WebM (VP9 + Opus)" Tag="Webm" />
                        <ComboBoxItem Content="AVI (MPEG-4 + MP3)" Tag="Avi" />
                        <ComboBoxItem Content="OGG (Theora + Vorbis)" Tag="Ogg" />
                        <ComboBoxItem Content="MOV (H.264 + AAC)" Tag="Mov" />
                        <ComboBoxItem Content="GIF animé (sans son)" Tag="Gif" />
                        <ComboBoxItem Content="Images PNG (extraire les images)" Tag="FramesPng" />
                        <ComboBoxItem Content="Images JPEG (extraire les images)" Tag="FramesJpeg" />
                    </ComboBox>
                    <Label Grid.Row="1" Content="Qualité" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Quality" SelectedIndex="1" Margin="0,0,0,8">
                        <ComboBoxItem Content="Haute (fichier plus lourd)" Tag="High" />
                        <ComboBoxItem Content="Moyenne (conseillé)" Tag="Medium" />
                        <ComboBoxItem Content="Faible (fichier léger)" Tag="Low" />
                    </ComboBox>
                    <Label Grid.Row="2" Content="Résolution max" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Resolution" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Comme l'original" Tag="0" />
                        <ComboBoxItem Content="2160p (4K)" Tag="2160" />
                        <ComboBoxItem Content="1080p (Full HD)" Tag="1080" />
                        <ComboBoxItem Content="720p (HD)" Tag="720" />
                        <ComboBoxItem Content="480p" Tag="480" />
                        <ComboBoxItem Content="360p" Tag="360" />
                    </ComboBox>
                    <Label Grid.Row="3" x:Name="FrameRateLabel" Content="Images" IsVisible="False" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FrameRate" SelectedIndex="1" Margin="0,0,0,8" IsVisible="False">
                        <ComboBoxItem Content="Toutes les images de la vidéo" Tag="0" />
                        <ComboBoxItem Content="1 image par seconde" Tag="1" />
                        <ComboBoxItem Content="2 images par seconde" Tag="2" />
                        <ComboBoxItem Content="5 images par seconde" Tag="5" />
                        <ComboBoxItem Content="1 image toutes les 2 secondes" Tag="0.5" />
                        <ComboBoxItem Content="1 image toutes les 5 secondes" Tag="0.2" />
                        <ComboBoxItem Content="1 image toutes les 10 secondes" Tag="0.1" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="RemoveAudio" Content="Supprimer le son" Margin="0,4,0,8" />
                <CheckBox x:Name="CopyStreams" Content="Changer seulement de conteneur (rapide, sans perte)"
                          IsCheckedChanged="Copy_Changed"
                          ToolTip.Tip="Copie les flux sans les réencoder. Très rapide, mais ne fonctionne que si les codecs d'origine sont acceptés par le format choisi (ex. MP4 → MKV)." />

                <TextBlock Text="EXTRAIT (FACULTATIF)" Classes="section" Margin="0,18,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Début" />
                    <TextBox Grid.Column="1" x:Name="TrimStart" Margin="0,0,14,8" ToolTip.Tip="Par exemple 1:30 ou 0:01:30,5 (vide = depuis le début)" />
                    <Label Grid.Column="2" Content="Fin" />
                    <TextBox Grid.Column="3" x:Name="TrimEnd" Margin="0,0,0,8" ToolTip.Tip="Par exemple 2:45 (vide = jusqu'à la fin)" />
                </Grid>
                <TextBlock Classes="note"
                           Text="Garde seulement le passage choisi, par exemple de 1:30 à 2:45. Laisse vide pour tout garder. S'applique à chaque fichier de la liste." />

                <TextBlock Text="DESTINATION" Classes="section" Margin="0,18,0,10" />
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="OutputDir" />
                </DockPanel>

                <Button Content="🎬  Convertir" Classes="primary" Click="Convert_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="14" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
