<UserControl x:Class="AllInOne.App.Views.ConvertAudioView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Convertir des sons" Classes="pageTitle" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="hint"
                   Text="Convertis tes fichiers audio en MP3, WAV, AIFF, FLAC, OGG, Opus ou M4A. Tu peux garder seulement un extrait, ou déposer des vidéos pour en extraire le son. Les originaux ne sont jamais modifiés." />

        <Border Grid.Row="2" Classes="card" Margin="0,0,16,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="＋  Ajouter des sons" Classes="primary" Click="Add_Click" />
                    <Button Content="🗑  Retirer" Click="Remove_Click" />
                    <Button Content="Vider" Classes="ghost" Click="Clear_Click" />
                </WrapPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <DockPanel>
                        <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="⬇  Télécharger FFmpeg" Click="Download_Click"
                                IsVisible="False" />
                        <TextBlock x:Name="FfmpegStatus" Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Classes="dropHint"
                               Text="Dépose tes sons ici&#x0a;MP3, WAV, AIFF, FLAC, OGG, Opus, M4A, WMA… ou des vidéos" />
                    <ListBox x:Name="Files" Classes="cards" SelectionMode="Multiple"
                             ItemTemplate="{StaticResource MediaItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Classes="card">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SORTIE" Classes="section" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Format" />
                    <ComboBox Grid.Column="1" x:Name="Format" SelectedIndex="0" Margin="0,0,0,8" SelectionChanged="Format_SelectionChanged">
                        <ComboBoxItem Content="MP3" Tag="Mp3" />
                        <ComboBoxItem Content="WAV (sans perte)" Tag="Wav" />
                        <ComboBoxItem Content="AIFF (sans perte)" Tag="Aiff" />
                        <ComboBoxItem Content="FLAC (sans perte, compressé)" Tag="Flac" />
                        <ComboBoxItem Content="OGG Vorbis" Tag="Ogg" />
                        <ComboBoxItem Content="Opus" Tag="Opus" />
                        <ComboBoxItem Content="M4A (AAC)" Tag="M4a" />
                    </ComboBox>
                    <Label Grid.Row="1" x:Name="QualityLabel" Content="Qualité" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Quality" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Haute" Tag="High" />
                        <ComboBoxItem Content="Moyenne" Tag="Medium" />
                        <ComboBoxItem Content="Faible (fichier léger)" Tag="Low" />
                    </ComboBox>
                    <Label Grid.Row="2" Content="Fréquence" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SampleRate" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Comme l'original" Tag="0" />
                        <ComboBoxItem Content="44,1 kHz (CD)" Tag="44100" />
                        <ComboBoxItem Content="48 kHz" Tag="48000" />
                        <ComboBoxItem Content="96 kHz" Tag="96000" />
                        <ComboBoxItem Content="22,05 kHz" Tag="22050" />
                    </ComboBox>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Canaux" />
                    <ComboBox Grid.Column="1" x:Name="Channels" SelectedIndex="0" Margin="0,0,0,8">
                        <ComboBoxItem Content="Comme l'original" Tag="0" />
                        <ComboBoxItem Content="Stéréo" Tag="2" />
                        <ComboBoxItem Content="Mono" Tag="1" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="EXTRAIT (FACULTATIF)" Classes="section" Margin="0,18,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Début" />
                    <TextBox Grid.Column="1" x:Name="TrimStart" Margin="0,0,14,8" ToolTip.Tip="Par exemple 1:30 ou 0:01:30,5 (vide = depuis le début)" />
                    <Label Grid.Column="2" Content="Fin" />
                    <TextBox Grid.Column="3" x:Name="TrimEnd" Margin="0,0,0,8" ToolTip.Tip="Par exemple 2:45 (vide = jusqu'à la fin)" />
                </Grid>
                <TextBlock Classes="note"
                           Text="Garde seulement le passage choisi, par exemple de 1:30 à 2:45. Laisse vide pour tout garder. S'applique à chaque fichier de la liste." />

                <TextBlock Text="DESTINATION" Classes="section" Margin="0,18,0,10" />
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="OutputDir" />
                </DockPanel>

                <Button Content="🎵  Convertir" Classes="primary" Click="Convert_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="14" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
