<UserControl x:Class="AllInOne.App.Views.PdfEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Hint}"
                   Text="Ouvrez un PDF, puis ajoutez d'autres PDF ou images pour les fusionner ou les insérer (après la page sélectionnée). Sélectionnez des pages pour les supprimer, les faire pivoter ou les déplacer ; vous pouvez aussi les glisser à la souris. Rien n'est modifié avant « Enregistrer sous »." />

        <WrapPanel Grid.Row="1">
            <Button Content="Ouvrir / ajouter des PDF ou images…" Click="Add_Click" />
            <Button Content="Supprimer les pages" Click="Delete_Click" />
            <Button Content="⟲ Pivoter à gauche" Click="RotateLeft_Click" />
            <Button Content="⟳ Pivoter à droite" Click="RotateRight_Click" />
            <Button Content="◀ Avancer" Click="Up_Click" ToolTip="Déplacer les pages sélectionnées d'un cran vers le début" />
            <Button Content="Reculer ▶" Click="Down_Click" ToolTip="Déplacer les pages sélectionnées d'un cran vers la fin" />
            <Button Content="⇤ Au début" Click="Start_Click" />
            <Button Content="À la fin ⇥" Click="End_Click" />
            <Button Content="Inverser l'ordre" Click="Reverse_Click" />
            <Button Content="Tout sélectionner" Click="SelectAll_Click" />
            <Button Content="Tout fermer" Click="Clear_Click" />
        </WrapPanel>

        <ListBox x:Name="Pages" Grid.Row="2" SelectionMode="Extended" Background="#F4F4F4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="Pages_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="6">
                        <Border Width="140" Height="180" Background="White" BorderBrush="#CCC" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA" />
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4">
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding Rotation}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Origin}" Foreground="#777" FontSize="11" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="0,0,20,6" Text="Aucune page." />
            <Label Content="Taille des pages ajoutées depuis des images :" />
            <ComboBox x:Name="ImagePageSize" SelectedIndex="0">
                <ComboBoxItem Content="A4" Tag="A4" />
                <ComboBoxItem Content="A3" Tag="A3" />
                <ComboBoxItem Content="A5" Tag="A5" />
                <ComboBoxItem Content="Lettre US" Tag="Letter" />
                <ComboBoxItem Content="Taille de l'image" Tag="FitImage" />
            </ComboBox>
            <Button Content="Enregistrer sous…" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </WrapPanel>
    </Grid>
</UserControl>
