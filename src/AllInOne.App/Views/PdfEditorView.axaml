<UserControl x:Class="AllInOne.App.Views.PdfEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Modifier / fusionner des PDF" Classes="pageTitle" />
        <TextBlock Grid.Row="1" Classes="hint"
                   Text="Ouvre un ou plusieurs PDF (ou des images) : toutes les pages s'affichent. Supprime, fais pivoter ou glisse les pages pour les réorganiser. Les fichiers ajoutés sont insérés après la page sélectionnée. Rien n'est modifié avant « Enregistrer »." />

        <Border Grid.Row="2" Classes="card">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="＋  Ajouter des PDF / images" Classes="primary" Click="Add_Click" />
                    <Button Content="🗑  Supprimer" Click="Delete_Click" ToolTip.Tip="Supprimer les pages sélectionnées (touche Suppr)" />
                    <Button Content="⟲" Click="RotateLeft_Click" ToolTip.Tip="Pivoter à gauche" FontSize="15" Padding="12,5" />
                    <Button Content="⟳" Click="RotateRight_Click" ToolTip.Tip="Pivoter à droite" FontSize="15" Padding="12,5" />
                    <Button Content="◀" Click="Up_Click" ToolTip.Tip="Avancer d'un cran" Padding="12,7" />
                    <Button Content="▶" Click="Down_Click" ToolTip.Tip="Reculer d'un cran" Padding="12,7" />
                    <Button Content="⇤  Au début" Click="Start_Click" />
                    <Button Content="À la fin  ⇥" Click="End_Click" />
                    <Button Content="⇅  Inverser" Click="Reverse_Click" ToolTip.Tip="Inverser l'ordre de toutes les pages" />
                    <Button Content="Tout sélectionner" Classes="ghost" Click="SelectAll_Click" />
                    <Button Content="Tout fermer" Classes="ghost" Click="Clear_Click" />
                </WrapPanel>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Classes="dropHint"
                               Text="Dépose tes PDF ou tes images ici&#x0a;pour les ouvrir, les fusionner ou les insérer" />
                    <ListBox x:Name="Pages" Classes="cards" SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="Pages_KeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="148">
                                    <Border Width="140" Height="184" CornerRadius="6" Background="{StaticResource CoverPlaceholder}">
                                        <Grid>
                                            <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDim}" />
                                            <LayoutTransformControl Margin="4">
                                                <LayoutTransformControl.LayoutTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </LayoutTransformControl.LayoutTransform>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </LayoutTransformControl>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Origin}" Foreground="{StaticResource TextDim}" FontSize="11"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" Margin="0,16,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="💾  Enregistrer sous…" Classes="primary" Click="Save_Click"
                        Padding="18,9" FontSize="14" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Summary" Text="Aucune page." FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,28,0" />
                    <TextBlock Text="Pages créées depuis des images :" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ImagePageSize" SelectedIndex="0" Width="160">
                        <ComboBoxItem Content="A4" Tag="A4" />
                        <ComboBoxItem Content="A3" Tag="A3" />
                        <ComboBoxItem Content="A5" Tag="A5" />
                        <ComboBoxItem Content="Lettre US" Tag="Letter" />
                        <ComboBoxItem Content="Taille de l'image" Tag="FitImage" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
