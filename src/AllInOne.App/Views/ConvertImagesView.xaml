<UserControl x:Class="AllInOne.App.Views.ConvertImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="FileListTemplate.xaml" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Hint}"
                   Text="Convertit des images vers un autre format (PNG, JPEG, WebP, BMP, GIF, TIFF). Formats lus : PNG, JPEG, BMP, GIF, TIFF, WebP, ICO, HEIC, AVIF. Les originaux ne sont jamais modifiés." />

        <WrapPanel Grid.Row="1">
            <Button Content="Ajouter des images…" Click="Add_Click" />
            <Button Content="Retirer" Click="Remove_Click" />
            <Button Content="Vider" Click="Clear_Click" />
        </WrapPanel>

        <ListBox x:Name="Files" Grid.Row="2" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                 ItemTemplate="{StaticResource FileItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Label Content="Format de sortie :" />
            <ComboBox x:Name="Format" SelectionChanged="Format_SelectionChanged" />
            <Label x:Name="QualityLabel" Content="Qualité :" />
            <Slider x:Name="Quality" Minimum="10" Maximum="100" Value="90" Width="120" VerticalAlignment="Center"
                    IsSnapToTickEnabled="True" TickFrequency="5" Margin="0,0,4,6" />
            <TextBlock Text="{Binding Value, ElementName=Quality}" VerticalAlignment="Center" Width="30" Margin="0,0,12,6" />
            <Label Content="Largeur max (px) :" />
            <TextBox x:Name="MaxWidthBox" Width="60" ToolTip="Vide = taille d'origine" />
            <Label Content="Hauteur max (px) :" />
            <TextBox x:Name="MaxHeightBox" Width="60" ToolTip="Vide = taille d'origine" />
        </WrapPanel>

        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="Dossier de sortie :" />
            <TextBox Grid.Column="1" x:Name="OutputDir" />
            <Button Grid.Column="2" Content="Parcourir…" Click="BrowseOutput_Click" />
            <Button Grid.Column="3" Content="Convertir" Style="{StaticResource PrimaryButton}" Click="Convert_Click" />
        </Grid>
    </Grid>
</UserControl>
