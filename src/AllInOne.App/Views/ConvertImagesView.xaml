<UserControl x:Class="AllInOne.App.Views.ConvertImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="FileListTemplate.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Convertir des images" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                   Text="Convertis un lot d'images vers PNG, JPEG, WebP, BMP, GIF ou TIFF, avec redimensionnement si besoin. Les originaux ne sont jamais modifiés." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="＋  Ajouter des images" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button Content="🗑  Retirer" Click="Remove_Click" />
                    <Button Content="Vider" Style="{StaticResource GhostButton}" Click="Clear_Click" />
                </WrapPanel>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource DropHint}"
                               Text="Dépose tes images ici&#x0a;PNG, JPEG, BMP, GIF, TIFF, WebP, ICO, HEIC, AVIF" />
                    <ListBox x:Name="Files" SelectionMode="Extended"
                             ItemTemplate="{StaticResource FileItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="SORTIE" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Format" />
                    <ComboBox Grid.Column="1" x:Name="Format" SelectionChanged="Format_SelectionChanged" Margin="0,0,0,8" />
                    <Label Grid.Row="1" x:Name="QualityLabel" Content="Qualité" />
                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Quality}" Width="30"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="Quality" Minimum="10" Maximum="100" Value="90" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="5" />
                    </DockPanel>
                    <Label Grid.Row="2" Content="Largeur max (px)" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxWidthBox" Margin="0,0,0,8" ToolTip="Vide = taille d'origine" />
                    <Label Grid.Row="3" Content="Hauteur max (px)" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxHeightBox" Margin="0,0,0,8" ToolTip="Vide = taille d'origine" />
                </Grid>

                <TextBlock Text="DESTINATION" Style="{StaticResource SectionTitle}" Margin="0,12,0,10" />
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                    <TextBox x:Name="OutputDir" />
                </DockPanel>

                <Button Content="🔁  Convertir" Style="{StaticResource PrimaryButton}" Click="Convert_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="14" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
