<UserControl x:Class="AllInOne.App.Views.CompressPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="FileListTemplate.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Compresser des PDF" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                   Text="Allège tes PDF (scans, documents pleins de photos) en réduisant leurs images. Le texte reste net et sélectionnable. Tout se fait sur ton ordinateur : rien n'est envoyé sur Internet." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="＋  Ajouter des PDF" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
                    <Button Content="🗑  Retirer" Click="Remove_Click" />
                    <Button Content="Vider" Style="{StaticResource GhostButton}" Click="Clear_Click" />
                </WrapPanel>
                <Grid>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource DropHint}" Text="Dépose tes PDF ici" />
                    <ListBox x:Name="Files" SelectionMode="Extended"
                             ItemTemplate="{StaticResource MediaItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="COMPRESSION" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Niveau" />
                        <ComboBox Grid.Column="1" x:Name="Level" SelectedIndex="1" Margin="0,0,0,8">
                            <ComboBoxItem Content="Légère (qualité quasi intacte)" Tag="Light" />
                            <ComboBoxItem Content="Moyenne (conseillé)" Tag="Medium" />
                            <ComboBoxItem Content="Forte (pour l'e-mail)" Tag="Strong" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"
                               Text="Légère : images jusqu'à 200 ppp. Moyenne : 150 ppp, bien pour l'écran et l'impression courante. Forte : 100 ppp, le plus léger. Un PDF déjà optimisé est simplement copié." />

                    <TextBlock Text="DESTINATION" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" />
                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                        <TextBox x:Name="OutputDir" />
                    </DockPanel>

                    <Button Content="🗜  Compresser" Style="{StaticResource PrimaryButton}" Click="Compress_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="14" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
