<UserControl x:Class="AllInOne.App.Views.ImagesToPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="FileListTemplate.xaml" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                   Text="Ajoutez une ou plusieurs images (ou glissez-les ici depuis l'Explorateur). Chaque image devient une page, dans l'ordre de la liste. Glissez les images pour changer l'ordre." />

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Button Content="Ajouter des images…" Click="Add_Click" />
            <Button Content="Retirer" Click="Remove_Click" />
            <Button Content="▲ Monter" Click="Up_Click" />
            <Button Content="▼ Descendre" Click="Down_Click" />
            <Button Content="Trier par nom" Click="Sort_Click" />
            <Button Content="Vider" Click="Clear_Click" />
        </WrapPanel>

        <ListBox x:Name="Files" Grid.Row="2" SelectionMode="Extended" Margin="0,0,10,0"
                 ItemTemplate="{StaticResource FileItemTemplate}" SelectionChanged="Files_SelectionChanged"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Border Grid.Row="2" Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA">
            <Image x:Name="Preview" Stretch="Uniform" Margin="6" />
        </Border>

        <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Label Content="Taille de page :" />
            <ComboBox x:Name="PageSize" SelectedIndex="0">
                <ComboBoxItem Content="A4" Tag="A4" />
                <ComboBoxItem Content="A3" Tag="A3" />
                <ComboBoxItem Content="A5" Tag="A5" />
                <ComboBoxItem Content="Lettre US" Tag="Letter" />
                <ComboBoxItem Content="Légal US" Tag="Legal" />
                <ComboBoxItem Content="Taille de l'image" Tag="FitImage" />
            </ComboBox>
            <Label Content="Orientation :" />
            <ComboBox x:Name="Orientation" SelectedIndex="0">
                <ComboBoxItem Content="Automatique" Tag="Auto" />
                <ComboBoxItem Content="Portrait" Tag="Portrait" />
                <ComboBoxItem Content="Paysage" Tag="Landscape" />
            </ComboBox>
            <Label Content="Marge (mm) :" />
            <TextBox x:Name="MarginBox" Width="50" Text="10" />
            <CheckBox x:Name="Enlarge" Content="Agrandir les petites images" IsChecked="True" />
            <Button Content="Créer le PDF…" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
        </WrapPanel>
    </Grid>
</UserControl>
