<Window x:Class="AllInOne.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AllInOne.App.Views"
        Title="AllInOne : PDF et images" Width="1180" Height="780" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <DockPanel>
        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradient}" Padding="24,16,24,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ALL" FontSize="28" FontWeight="Black" />
                    <TextBlock Text="·IN·ONE" FontSize="28" FontWeight="Black" Foreground="{StaticResource AccentGradient}" />
                </StackPanel>
                <TextBlock Text="Tes PDF et tes images, sans prise de tête" Foreground="{StaticResource TextDim}" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Arrêter" Click="Cancel_Click"
                        Visibility="Collapsed" Padding="10,3" Margin="10,0,0,0" />
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Style="{StaticResource ThinBar}" Width="200"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Prêt." Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border x:Name="Nav" DockPanel.Dock="Left" Width="240" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,18">
            <StackPanel>
                <TextBlock Text="OUTILS" Style="{StaticResource SectionTitle}" Margin="14,0,0,10" />
                <RadioButton Style="{StaticResource NavButton}" Content="🖼   Images → PDF" Tag="0" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Content="📄   Modifier / fusionner" Tag="1" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Content="🧩   PDF → images" Tag="2" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Content="🔁   Convertir des images" Tag="3" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Content="🎬   Convertir des vidéos" Tag="4" Checked="Nav_Checked" />
                <RadioButton Style="{StaticResource NavButton}" Content="🎵   Convertir des sons" Tag="5" Checked="Nav_Checked" />
            </StackPanel>
        </Border>

        <!-- Contenu : un seul écran visible à la fois (les autres gardent leur état) -->
        <Grid x:Name="Pages" Margin="24,20,24,16">
            <views:ImagesToPdfView />
            <views:PdfEditorView Visibility="Collapsed" />
            <views:PdfToImagesView Visibility="Collapsed" />
            <views:ConvertImagesView Visibility="Collapsed" />
            <views:ConvertVideosView Visibility="Collapsed" />
            <views:ConvertAudioView Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
