<Window x:Class="AllInOne.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AllInOne.App.Views"
        Title="AllInOne : PDF et images" Width="1100" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Prêt." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="Progress" Width="220" Height="14" Minimum="0" Maximum="1" Visibility="Collapsed" />
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="Tabs" Margin="8">
            <TabItem Header="  Images → PDF  ">
                <views:ImagesToPdfView />
            </TabItem>
            <TabItem Header="  Modifier / fusionner des PDF  ">
                <views:PdfEditorView />
            </TabItem>
            <TabItem Header="  PDF → images  ">
                <views:PdfToImagesView />
            </TabItem>
            <TabItem Header="  Convertir des images  ">
                <views:ConvertImagesView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
